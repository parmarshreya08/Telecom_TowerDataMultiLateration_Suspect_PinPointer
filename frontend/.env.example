# ============================================================
# E-Rakshak Frontend — Environment Variables
# Copy to .env and fill in your values
# ============================================================

# Backend API base URL (FastAPI server)
VITE_API_BASE_URL=http://localhost:8000

# WebSocket base URL (for real-time tracking — not yet implemented in backend)
VITE_WS_BASE_URL=ws://localhost:8000

# API Key for X-API-Key header (must match backend API_KEY_SECRET)
# TODO: Set this once backend wires verify_api_key dependency
VITE_API_KEY=change-this-to-a-secure-random-key-in-production
