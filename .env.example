# ==============================================================================
# E-Rakshak Secrets (Example)
# Copy this file to '.env' and fill in your values.
# Non-secret configuration (host, port, log level, limits, bucket name, etc.)
# lives as defaults in app/core/config.py — override via real env vars if needed.
# ==============================================================================

# JWT / API signing secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_KEY_SECRET="change-this-to-a-secure-random-key-in-production"

# Neon CLI API key (optional — manage Neon projects from the terminal)
NEON_API_KEY="your-neon-api-key"

# Neon Postgres (async driver for FastAPI; sync driver for Alembic)
DATABASE_URL="postgresql+asyncpg://user:pass@ep-example.us-east-2.aws.neon.tech/neondb?ssl=require"
SYNC_DATABASE_URL="postgresql+psycopg2://user:pass@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Supabase Storage (service role key)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-service-role-key"