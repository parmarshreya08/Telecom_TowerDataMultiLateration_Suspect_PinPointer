# ==============================================================================
# E-Rakshak Ingestion Pipeline Environment Variables (Example)
# Copy this file to '.env' and modify it for your local environment
# ==============================================================================

# Application Settings
APP_NAME="E-Rakshak Telecom Ingestion"
APP_ENV=development  # options: development, testing, staging, production
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Security Settings
# API_KEY_SECRET is used for authenticating officer requests if needed
API_KEY_SECRET="change-this-to-a-secure-random-key-in-production"

# Database Settings
# Note: FastAPI uses async pg driver (postgresql+asyncpg)
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/erakshak"
# Note: Alembic migrations use synchronous driver (postgresql+psycopg2)
SYNC_DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/erakshak"

# Storage Settings
UPLOAD_DIR="./uploads"
MAX_CONTENT_LENGTH_MB=100
ALLOWED_EXTENSIONS="csv,xlsx,xls,txt,docx,pdf"
