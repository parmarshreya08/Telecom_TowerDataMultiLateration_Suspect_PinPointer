# ==============================================================================
# E-Rakshak Ingestion Pipeline Environment Variables (Example)
# Copy this file to '.env' and modify it for your local environment
# ==============================================================================

# Application Settings
APP_NAME="E-Rakshak Telecom Ingestion"
APP_ENV=development  # options: development, testing, staging, production
DEBUG=true
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Neon CLI API key (manage Neon projects from the terminal)
NEON_API_KEY="your-neon-api-key"

# Database Settings
# Note: FastAPI uses async pg driver (postgresql+asyncpg); Neon requires ssl=require
DATABASE_URL="postgresql+asyncpg://user:pass@ep-example.us-east-2.aws.neon.tech/neondb?ssl=require"
# Note: Alembic migrations use synchronous driver (postgresql+psycopg2)
SYNC_DATABASE_URL="postgresql+psycopg2://user:pass@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Storage Settings
UPLOAD_DIR="./uploads"
MAX_CONTENT_LENGTH_MB=100
ALLOWED_EXTENSIONS="csv,xlsx,xls,txt,docx,pdf"

# Cloudinary (direct-to-storage uploads)
# Get these from your Cloudinary dashboard: Settings -> Access Keys
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_UPLOAD_FOLDER="erakshak-uploads"

# Google Drive Picker (Drive import)
# From Google Cloud Console: APIs & Services -> Credentials
GOOGLE_CLIENT_ID="your-oauth-web-client-id.apps.googleusercontent.com"
GOOGLE_API_KEY="your-google-api-key"
GOOGLE_PROJECT_ID="your-gcp-project-id"

# Localization Engine
# UTM zone (0 = auto-detect from longitude). Surat = 43.
UTM_ZONE=43

# OpenCellID (tower geolocation fallback)
# Register at https://opencellid.org to get a free API key
OPENCELLID_API_KEY="your-opencellid-api-key"
